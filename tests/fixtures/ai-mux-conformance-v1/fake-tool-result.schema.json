{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-mux.local/conformance/v1/fake-tool-result.schema.json",
  "title": "ai-mux Fake Tool Result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "artifactType": { "type": "string", "const": "fixture.tool.v1" },
    "status": { "type": "string", "enum": ["success", "partial"] },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "files": { "type": "integer", "minimum": 0 }
  },
  "required": ["schemaVersion", "artifactType", "status", "warnings", "files"],
  "examples": [
    {
      "schemaVersion": "1",
      "artifactType": "fixture.tool.v1",
      "status": "success",
      "warnings": [],
      "files": 3
    }
  ]
}
